# Copy this file to .env and fill in your own keys. Never commit .env itself.

# Required for summarization and grounded Q&A generation.
# Get a free key at https://ai.google.dev
# Verify current free-tier limits there before relying on them long-term.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — only needed for questions that use web search (WEB_ONLY or
# PDF_AND_WEB routes). Without this, PDF-only questions still work fine.
# Get a free key (1,000 searches/month, no credit card required as of
# September 2026) at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
